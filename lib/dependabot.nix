# The ONE Dependabot generator. kattakath/nix-config's .github/dependabot.yml is the reference
# shape. GitHub has no org-level or inherited dependabot.yml, so every repo renders its file here:
# through the flakeModule (repoKit.dependabot) or directly as `repo-kit.lib.dependabot`.
#
#   repo-kit.lib.dependabot {
#     inherit pkgs;                 # YAML rendering needs remarshal: Nix has no builtin toYAML
#     directories = [ ... ];        # beyond "/" (always included): composite actions with uses:
#     settings = { ... };           # keys ADDED to the shared github-actions entry
#     updates = [ { ... } ];        # more ecosystems; each gets the 7-day cooldown by default
#     src = self;                   # optional: enables passthru.directoriesCheck
#   }
#
# Returns the file (a derivation) carrying `config` (the attrset), `schemaCheck` and, when
# `src` is given, `directoriesCheck` and `missingDirectories`. Both checks are derivations to put under `checks`.
{ lib }:
{
  pkgs,
  directories ? [ ],
  settings ? { },
  updates ? [ ],
  src ? null,
}:
let
  # The fleet's github-actions entry. A repo ADDS to it (directories, other keys) but cannot
  # override these keys: that is how ismailkattakath/userscripts drifted to monthly/ungrouped.
  sharedActions = {
    package-ecosystem = "github-actions";
    # "/" is always there; listing it again is harmless.
    directories = lib.unique ([ "/" ] ++ directories);
    schedule.interval = "weekly";
    # A supply-chain hold, not a convenience: a compromised release yanked within a week never
    # becomes a pinned SHA. 7 = the default-days zizmor's dependabot-cooldown rule looks for.
    cooldown.default-days = 7;
    groups.github-actions.patterns = [ "*" ];
  };
  clash = lib.intersectLists (builtins.attrNames settings) (builtins.attrNames sharedActions);
  # zizmor's dependabot-cooldown checks every entry, so added ecosystems get the hold too.
  extra = map (u: lib.recursiveUpdate { cooldown.default-days = 7; } u) updates;

  config =
    assert lib.assertMsg (clash == [ ])
      "repo-kit dependabot: `settings` may only ADD keys to the shared github-actions entry; it sets ${lib.concatStringsSep ", " clash} (add directories through `directories`)";
    {
      version = 2;
      updates = [ (sharedActions // settings) ] ++ extra;
    };

  yaml = pkgs.formats.yaml { };
  render =
    name: value:
    pkgs.runCommandLocal name { } ''
      {
        echo "# Generated by repo-kit (repoKit.dependabot or lib.dependabot); change those options, not this file."
        echo "# github-actions: weekly, one grouped PR, a 7-day cooldown (a supply-chain hold), on /"
        echo "# plus each composite action with its own uses: (the directories option)."
        # remarshal opens with a `%YAML 1.1` directive; dropped so the header comment leads.
        grep -v '^%YAML' ${yaml.generate "${name}.body" value}
      } > "$out"
    '';

  file = render "dependabot.yml" config;
  # Negative control: the same renderer with ONE bad value must fail the same validator, or a
  # green schema check would prove nothing.
  bad = render "dependabot-bad.yml" (
    config
    // {
      updates = map (u: u // { schedule.interval = "fortnightly"; }) config.updates;
    }
  );

  schemaCheck =
    pkgs.runCommandLocal "dependabot-schema" { nativeBuildInputs = [ pkgs.check-jsonschema ]; }
      ''
        check-jsonschema --builtin-schema vendor.dependabot ${file}
        if check-jsonschema --builtin-schema vendor.dependabot ${bad} >bad.log 2>&1; then
          echo "negative control: a schedule.interval of 'fortnightly' passed the schema" >&2
          exit 1
        fi
        grep -q fortnightly bad.log || { cat bad.log >&2; echo "negative control failed for another reason" >&2; exit 1; }
        echo "dependabot.yml matches the schema; the negative control is rejected" > "$out"
      '';

  # A composite action is its own manifest location to Dependabot: "/" covers only
  # .github/workflows, so an unlisted action.yml with its own `uses:` never gets a bump
  # (kattakath/nix-config measured 0 of 10 grouped bumps reaching one). Found from the source,
  # one level under each root.
  compositeActionDirs =
    let
      inRoot =
        root:
        let
          dir = "${src}/${root}";
          hasUses =
            name:
            lib.any
              (
                f:
                let
                  p = "${dir}/${name}/${f}";
                in
                builtins.pathExists p
                && lib.any (l: builtins.match "[[:space:]-]*uses:.*" l != null) (
                  lib.splitString "\n" (builtins.readFile p)
                )
              )
              [
                "action.yml"
                "action.yaml"
              ];
        in
        lib.optionals (builtins.pathExists dir) (
          map (n: "/${root}/${n}") (
            builtins.filter hasUses (
              builtins.attrNames (lib.filterAttrs (_: t: t == "directory") (builtins.readDir dir))
            )
          )
        );
    in
    lib.concatMap inRoot [
      ".github/actions"
      "actions"
    ];
  missingDirs = lib.subtractLists sharedActions.directories compositeActionDirs;

  directoriesCheck = pkgs.runCommandLocal "dependabot-directories" { } (
    if missingDirs == [ ] then
      ''echo "every composite action with a uses: is listed (${toString (builtins.length compositeActionDirs)} found)" > "$out"''
    else
      ''
        echo "composite actions with their own uses: missing from the dependabot directories: ${toString missingDirs}" >&2
        exit 1
      ''
  );
in
file
// {
  inherit config schemaCheck;
}
// lib.optionalAttrs (src != null) {
  inherit directoriesCheck;
  missingDirectories = missingDirs;
}
